# Copy this file to .env.aws-demo on the EC2 server. Never commit the real file.
POSTGRES_DB=textile_db
POSTGRES_USER=textile
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-32-random-characters

# Replace with the EC2 public IP, for example: http://13.232.10.20
PUBLIC_ORIGIN=http://YOUR_EC2_PUBLIC_IP

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_BYTES=10485760
