POSTGRES_DB=textile_db
APP_ENV=development
POSTGRES_USER=textile
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://textile:replace-with-a-strong-password@db:5432/textile_db
DB_SSLMODE=prefer
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_BYTES=10485760
# Frontend API address. In Vercel, set this to the public HTTPS backend URL.
VITE_API_URL=http://localhost:8000
# Backend setting. In production, replace these local origins with the exact Vercel URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
STORAGE_BACKEND=local
UPLOAD_DIR=static/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REDIS_URL=redis://redis:6379/0
TASK_MODE=local
